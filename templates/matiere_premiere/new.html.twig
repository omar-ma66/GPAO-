{% extends 'base.html.twig' %}

{% block title %}Nouvelle matière première{% endblock %}

{% block body %}

<div class="min-h-[calc(100vh-4rem)] bg-gray-100 py-10">


<div class="mx-auto max-w-2xl px-4 sm:px-6">

    <div class="mb-8">

        <a
            href="{{ path('app_matiere_premiere') }}"
            class="text-sm font-semibold text-blue-600
                   hover:text-blue-800"
        >
            ← Retour aux matières premières
        </a>

        <h1 class="mt-4 text-3xl font-bold text-gray-900">
            Nouvelle matière première
        </h1>

        <p class="mt-2 text-sm text-gray-600">
            Ajoutez une nouvelle matière première au catalogue.
        </p>

    </div>

    <div class="rounded-2xl bg-white p-6 shadow-lg sm:p-8">

        {{ form_start(form) }}

            <div class="space-y-6">

                <div>
                    {{ form_label(
                        form.nom,
                        'Nom',
                        {
                            label_attr: {
                                class: 'block text-sm font-semibold text-gray-700'
                            }
                        }
                    ) }}

                    {{ form_widget(
                        form.nom,
                        {
                            attr: {
                                class: 'mt-2 block w-full rounded-lg
                                        border border-gray-300 bg-white
                                        px-4 py-3 text-gray-900 shadow-sm
                                        outline-none focus:border-blue-500
                                        focus:ring-2 focus:ring-blue-500'
                            }
                        }
                    ) }}

                    {{ form_errors(form.nom) }}
                </div>

                <div>
                    {{ form_label(
                        form.reference,
                        'Référence',
                        {
                            label_attr: {
                                class: 'block text-sm font-semibold text-gray-700'
                            }
                        }
                    ) }}

                    {{ form_widget(
                        form.reference,
                        {
                            attr: {
                                class: 'mt-2 block w-full rounded-lg
                                        border border-gray-300 bg-white
                                        px-4 py-3 text-gray-900 shadow-sm
                                        outline-none focus:border-blue-500
                                        focus:ring-2 focus:ring-blue-500'
                            }
                        }
                    ) }}

                    {{ form_errors(form.reference) }}
                </div>

                <div>
                    {{ form_label(
                        form.description,
                        'Description',
                        {
                            label_attr: {
                                class: 'block text-sm font-semibold text-gray-700'
                            }
                        }
                    ) }}

                    {{ form_widget(
                        form.description,
                        {
                            attr: {
                                rows: 5,
                                class: 'mt-2 block w-full rounded-lg
                                        border border-gray-300 bg-white
                                        px-4 py-3 text-gray-900 shadow-sm
                                        outline-none focus:border-blue-500
                                        focus:ring-2 focus:ring-blue-500'
                            }
                        }
                    ) }}

                    {{ form_errors(form.description) }}
                </div>

                <div class="flex flex-col gap-3 pt-4 sm:flex-row">

                    <button
                        type="submit"
                        class="rounded-lg bg-blue-600 px-5 py-3
                               text-sm font-semibold text-white
                               shadow-sm transition hover:bg-blue-700"
                    >
                        Créer la matière première
                    </button>

                    <a
                        href="{{ path('app_matiere_premiere') }}"
                        class="rounded-lg bg-gray-100 px-5 py-3
                               text-center text-sm font-semibold
                               text-gray-700 transition hover:bg-gray-200"
                    >
                        Annuler
                    </a>

                </div>

            </div>

        {{ form_end(form) }}

    </div>

</div>


</div>

{% endblock %}
