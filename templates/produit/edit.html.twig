
{% extends 'base.html.twig' %}

{% block title %}
    Modifier le produit
{% endblock %}

{% block body %}

<div class="min-h-screen bg-gray-100 py-10">

    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">

        <div class="mb-8">

            <h1 class="text-3xl font-bold text-gray-900">
                Modifier le produit
            </h1>

            <p class="mt-1 text-sm text-gray-600">
                Modification de :
                <span class="font-semibold">
                    {{ produit.nom }}
                </span>
            </p>

        </div>


        <div class="rounded-xl bg-white p-6 shadow-md sm:p-8">

            {{ form_start(form) }}

                <div class="space-y-6">

                    {{ form_row(form.nom, {
                        label: 'Nom du produit',
                        attr: {
                            class: 'mt-1 block w-full rounded-lg border-gray-300
                                    shadow-sm focus:border-blue-500
                                    focus:ring-blue-500'
                        }
                    }) }}

                    {{ form_row(form.reference, {
                        label: 'Référence',
                        attr: {
                            class: 'mt-1 block w-full rounded-lg border-gray-300
                                    shadow-sm focus:border-blue-500
                                    focus:ring-blue-500'
                        }
                    }) }}

                    {{ form_row(form.description, {
                        label: 'Description',
                        attr: {
                            class: 'mt-1 block w-full rounded-lg border-gray-300
                                    shadow-sm focus:border-blue-500
                                    focus:ring-blue-500'
                        }
                    }) }}

                    <div>

                        {{ form_label(form.matierePremiere) }}

                        <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">

                            {% for choice in form.matierePremiere %}

                                <label
                                    class="flex cursor-pointer items-center
                                           gap-3 rounded-lg border border-gray-200
                                           bg-gray-50 p-4 transition
                                           hover:border-blue-400
                                           hover:bg-blue-50"
                                >

                                    {{ form_widget(choice, {
                                        attr: {
                                            class: 'h-4 w-4 rounded border-gray-300
                                                    text-blue-600
                                                    focus:ring-blue-500'
                                        }
                                    }) }}

                                    <span class="text-sm font-medium text-gray-700">
                                        {{ form_label(choice) }}
                                    </span>

                                </label>

                            {% endfor %}

                        </div>

                    </div>

                </div>


                <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row">

                    <a
                        href="{{ path('app_produit') }}"
                        class="inline-flex justify-center rounded-lg
                               bg-gray-200 px-5 py-3 text-sm font-semibold
                               text-gray-700 transition
                               hover:bg-gray-300"
                    >
                        Annuler
                    </a>

                    <button
                        type="submit"
                        class="inline-flex justify-center rounded-lg
                               bg-green-600 px-5 py-3 text-sm font-semibold
                               text-white shadow-sm transition
                               hover:bg-green-700
                               focus:outline-none focus:ring-2
                               focus:ring-green-500 focus:ring-offset-2"
                    >
                        Enregistrer les modifications
                    </button>

                </div>

            {{ form_end(form) }}

        </div>

    </div>

</div>

{% endblock %}

