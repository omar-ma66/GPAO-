{% extends 'base.html.twig' %}

{% block title %}
Connexion
{% endblock %}

{% block body %}

<div class="min-h-[calc(100vh-4rem)] bg-gray-100 py-12">

<div class="mx-auto max-w-md px-4 sm:px-6">

    <div class="mb-8 text-center">

        <div
            class="mx-auto mb-4 flex h-14 w-14 items-center
                   justify-center rounded-full bg-blue-600
                   text-2xl font-bold text-white shadow-md"
        >
            G
        </div>

        <h1 class="text-3xl font-bold tracking-tight text-gray-900">
            Connexion
        </h1>

        <p class="mt-2 text-sm text-gray-600">
            Connectez-vous à votre espace GPAO
        </p>

    </div>

    <div class="rounded-2xl bg-white p-6 shadow-lg sm:p-8">

        {% if error %}

            <div
                class="mb-6 rounded-lg border border-red-200
                       bg-red-50 p-4 text-sm text-red-700"
            >
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>

        {% endif %}

        {% if app.user %}

            <div
                class="mb-6 rounded-lg border border-blue-200
                       bg-blue-50 p-4 text-sm text-blue-800"
            >
                <p>
                    Vous êtes connecté en tant que
                    <strong>{{ app.user.userIdentifier }}</strong>.
                </p>

                <a
                    href="{{ logout_path() }}"
                    class="mt-2 inline-block font-semibold
                           text-blue-600 hover:text-blue-800"
                >
                    Se déconnecter
                </a>
            </div>

        {% endif %}

        <form method="post">

            <div class="space-y-6">

                <div>

                    <label
                        for="username"
                        class="block text-sm font-semibold text-gray-700"
                    >
                        Adresse e-mail
                    </label>

                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        class="mt-2 block w-full rounded-lg
                               border border-gray-300 bg-white
                               px-4 py-3 text-gray-900 shadow-sm
                               outline-none transition
                               focus:border-blue-500
                               focus:ring-2 focus:ring-blue-500"
                        autocomplete="email"
                        required
                        autofocus
                    >

                </div>

                <div>

                    <label
                        for="password"
                        class="block text-sm font-semibold text-gray-700"
                    >
                        Mot de passe
                    </label>

                    <input
                        type="password"
                        name="_password"
                        id="password"
                        class="mt-2 block w-full rounded-lg
                               border border-gray-300 bg-white
                               px-4 py-3 text-gray-900 shadow-sm
                               outline-none transition
                               focus:border-blue-500
                               focus:ring-2 focus:ring-blue-500"
                        autocomplete="current-password"
                        required
                    >

                </div>

                <input
                    type="hidden"
                    name="_csrf_token"
                    data-controller="csrf-protection"
                    value="{{ csrf_token('authenticate') }}"
                >

                <button
                    class="w-full rounded-lg bg-blue-600
                           px-5 py-3 text-sm font-semibold
                           text-white shadow-sm transition
                           hover:bg-blue-700
                           focus:outline-none
                           focus:ring-2 focus:ring-blue-500
                           focus:ring-offset-2"
                    type="submit"
                >
                    Se connecter
                </button>

            </div>

        </form>

        <div class="mt-6 border-t border-gray-200 pt-6 text-center">

            <p class="text-sm text-gray-600">
                Vous n'avez pas encore de compte ?
            </p>

            <a
                href="{{ path('app_register') }}"
                class="mt-2 inline-block text-sm font-semibold
                       text-blue-600 transition
                       hover:text-blue-800"
            >
                Créer un compte
            </a>

        </div>

    </div>

</div>


</div>

{% endblock %}
