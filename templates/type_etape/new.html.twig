{% extends 'base.html.twig' %}

{% block title %}Nouvelle étape{% endblock %}

{% block body %}

<div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">

    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">
            Nouvelle étape de fabrication
        </h1>

        <p class="mt-2 text-gray-600">
            Ajoutez une étape au catalogue de l'entreprise.
        </p>
    </div>

    <div class="rounded-xl bg-white p-6 shadow-sm sm:p-8">

        {{ form_start(form) }}

            <div class="space-y-6">

                {{ form_row(form.nom) }}

                {{ form_row(form.description) }}

            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">

                <button
                    type="submit"
                    class="rounded-lg bg-blue-600 px-5 py-3 font-semibold text-white hover:bg-blue-700"
                >
                    Créer l'étape
                </button>

                <a
                    href="{{ path('app_type_etape') }}"
                    class="rounded-lg bg-gray-100 px-5 py-3 text-center font-semibold text-gray-700 hover:bg-gray-200"
                >
                    Annuler
                </a>

            </div>

        {{ form_end(form) }}

    </div>

</div>

{% endblock %}

