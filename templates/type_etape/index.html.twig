{% extends 'base.html.twig' %}

{% block title %}Types d’étapes{% endblock %}

{% block body %}

<div class="mx-auto max-w-6xl px-4 py-8">


<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>
        <h1 class="text-3xl font-bold text-slate-900">
            Types d’étapes
        </h1>

        <p class="mt-1 text-slate-600">
            Gérez les étapes disponibles dans votre entreprise.
        </p>
    </div>

    <a
        href="{{ path('app_type_etape_new') }}"
        class="inline-flex items-center justify-center rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700"
    >
        + Nouvelle étape
    </a>

</div>

{% for message in app.flashes('success') %}
    <div class="mb-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-green-800">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-800">
        {{ message }}
    </div>
{% endfor %}

{% if typesEtapes is empty %}

    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center shadow-sm">

        <h2 class="text-xl font-semibold text-slate-800">
            Aucun type d’étape
        </h2>

        <p class="mt-2 text-slate-500">
            Créez votre première étape de fabrication.
        </p>

        <a
            href="{{ path('app_type_etape_new') }}"
            class="mt-5 inline-flex rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700"
        >
            Créer une étape
        </a>

    </div>

{% else %}

    <div class="overflow-hidden rounded-2xl bg-white shadow-sm">

        <div class="overflow-x-auto">

            <table class="min-w-full divide-y divide-slate-200">

                <thead class="bg-slate-50">

                    <tr>

                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                            Nom
                        </th>

                        <th class="px-6 py-4 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                            Description
                        </th>

                        <th class="px-6 py-4 text-center text-xs font-semibold uppercase tracking-wide text-slate-500">
                            Utilisée
                        </th>

                        <th class="px-6 py-4 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody class="divide-y divide-slate-200">

                    {% for typeEtape in typesEtapes %}

                        <tr class="hover:bg-slate-50">

                            <td class="px-6 py-4">

                                <div class="font-semibold text-slate-900">
                                    {{ typeEtape.nom }}
                                </div>

                            </td>

                            <td class="px-6 py-4">

                                {% if typeEtape.description %}

                                    <div class="max-w-md text-sm text-slate-600">
                                        {{ typeEtape.description }}
                                    </div>

                                {% else %}

                                    <span class="text-sm italic text-slate-400">
                                        Aucune description
                                    </span>

                                {% endif %}

                            </td>

                            <td class="px-6 py-4 text-center">

                                {% set nombreUtilisations = typeEtape.etapeFabrications|length %}

                                {% if nombreUtilisations > 0 %}

                                    <span class="inline-flex rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-700">
                                        {{ nombreUtilisations }}
                                        utilisation{{ nombreUtilisations > 1 ? 's' : '' }}
                                    </span>

                                {% else %}

                                    <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-500">
                                        Non utilisée
                                    </span>

                                {% endif %}

                            </td>

                            <td class="px-6 py-4">

                                <div class="flex justify-end gap-2">

                                    <a
                                        href="{{ path('app_type_etape_edit', {
                                            id: typeEtape.id
                                        }) }}"
                                        class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                                    >
                                        Modifier
                                    </a>

                                    {% if is_granted('ROLE_ADMIN') and nombreUtilisations == 0 %}

                                        <form
                                            method="post"
                                            action="{{ path('app_type_etape_delete', {
                                                id: typeEtape.id
                                            }) }}"
                                            onsubmit="return confirm('Voulez-vous vraiment supprimer cette étape ?');"
                                        >

                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('supprimer_type_etape_' ~ typeEtape.id) }}"
                                            >

                                            <button
                                                type="submit"
                                                class="rounded-lg border border-red-200 px-3 py-2 text-sm font-semibold text-red-600 hover:bg-red-50"
                                            >
                                                Supprimer
                                            </button>

                                        </form>

                                    {% elseif is_granted('ROLE_ADMIN') %}

                                        <span
                                            class="rounded-lg bg-slate-100 px-3 py-2 text-xs font-medium text-slate-400"
                                            title="Cette étape est utilisée par un OF"
                                        >
                                            Utilisée
                                        </span>

                                    {% endif %}

                                </div>

                            </td>

                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

{% endif %}


</div>

{% endblock %}
