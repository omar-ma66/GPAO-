{% extends 'base.html.twig' %}

{% block title %}Nouvel ordre de fabrication{% endblock %}

{% block body %}

<div class="mx-auto max-w-3xl px-4 py-8">


<div class="mb-8">

    <a
        href="{{ path('app_ordre_fabrication') }}"
        class="text-sm text-slate-500 hover:text-slate-900"
    >
        ← Retour aux ordres de fabrication
    </a>

    <h1 class="mt-4 text-3xl font-bold text-slate-900">
        Nouvel ordre de fabrication
    </h1>

    <p class="mt-2 text-slate-600">
        Définissez le produit, la quantité et les matières premières
        utilisées pour cet OF.
    </p>

</div>

{% for message in app.flashes('error') %}

    <div class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-800">
        {{ message }}
    </div>

{% endfor %}

<div
    class="rounded-2xl bg-white p-6 shadow-sm md:p-8"
    data-controller="matieres-premieres"
>

    {{ form_start(form) }}

    {{ form_errors(form) }}

    <div class="space-y-6">

        <!-- QUANTITE -->

        <div>

            {{ form_label(form.quantite, null, {
                label_attr: {
                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                }
            }) }}

            {{ form_widget(form.quantite, {
                attr: {
                    class: 'w-full rounded-lg border border-slate-300 px-4 py-3 focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200'
                }
            }) }}

            {{ form_errors(form.quantite) }}

        </div>

        <!-- PRODUIT -->

        <div>

            {{ form_label(form.produit, null, {
                label_attr: {
                    class: 'mb-2 block text-sm font-semibold text-slate-700'
                }
            }) }}

            {{ form_widget(form.produit, {
                attr: {
                    class: 'w-full rounded-lg border border-slate-300 px-4 py-3 focus:border-slate-500 focus:outline-none focus:ring-2 focus:ring-slate-200',
                    'data-matieres-premieres-target': 'produit',
                    'data-action': 'change->matieres-premieres#produitChange'
                }
            }) }}

            {{ form_errors(form.produit) }}

        </div>

        <!-- MATIERES PREMIERES -->

        <div>

            {{ form_label(form.matieresPremieres, null, {
                label_attr: {
                    class: 'mb-3 block text-sm font-semibold text-slate-700'
                }
            }) }}

            <p class="mb-3 text-sm text-slate-500">
                Seules les matières premières associées au produit
                sélectionné sont proposées.
            </p>

            <div
                data-matieres-premieres-target="message"
                class="mb-3 rounded-xl border border-dashed border-slate-300 bg-slate-50 p-4 text-sm text-slate-600"
            >
                Sélectionnez d’abord un produit pour afficher les matières
                premières disponibles.
            </div>

            <div class="space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-4">

                {% for matiereField in form.matieresPremieres %}

                    <label
                        data-matieres-premieres-target="option"
                        class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-200 bg-white p-3 hover:bg-slate-50"
                    >

                        {{ form_widget(matiereField, {
                            attr: {
                                class: 'h-4 w-4 rounded border-slate-300'
                            }
                        }) }}

                        <span class="text-sm font-medium text-slate-700">
                            {{ matiereField.vars.label }}
                        </span>

                    </label>

                {% endfor %}

            </div>

            {{ form_errors(form.matieresPremieres) }}

        </div>

    </div>

    <div class="mt-8 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

        <a
            href="{{ path('app_ordre_fabrication') }}"
            class="rounded-lg border border-slate-300 px-5 py-3 text-center text-sm font-semibold text-slate-700 hover:bg-slate-50"
        >
            Annuler
        </a>

        <button
            type="submit"
            class="rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700"
        >
            Créer l'OF et configurer les étapes
        </button>

    </div>

    {{ form_end(form) }}

</div>


</div>

{% endblock %}
