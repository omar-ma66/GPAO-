{% extends 'base.html.twig' %}

{% block title %}Ordres de fabrication{% endblock %}

{% block body %}

<div class="min-h-screen bg-gray-100 py-8">

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div
            class="mb-8 flex flex-col gap-4
                   sm:flex-row sm:items-center sm:justify-between"
        >

            <div>

                <h1 class="text-3xl font-bold tracking-tight text-gray-900">
                    Ordres de fabrication
                </h1>

                <p class="mt-1 text-sm text-gray-600">
                    Suivi de la production et des étapes de fabrication.
                </p>

            </div>

            {% if is_granted('ROLE_USER') %}

                <a
                    href="{{ path('app_ordre_fabrication_new') }}"
                    class="inline-flex items-center justify-center
                           rounded-lg bg-blue-600 px-5 py-3
                           text-sm font-semibold text-white
                           shadow-sm transition hover:bg-blue-700"
                >
                    + Nouvel ordre de fabrication
                </a>

            {% endif %}

        </div>


        {% for message in app.flashes('success') %}

            <div
                class="mb-6 rounded-lg border border-green-200
                       bg-green-50 p-4 text-sm font-medium
                       text-green-700"
            >
                {{ message }}
            </div>

        {% endfor %}


        <div
            class="grid grid-cols-1 gap-6 lg:grid-cols-3"
            data-controller="kanban"
        >


            {# ================================================== #}
            {# EN ATTENTE                                          #}
            {# ================================================== #}

            <div
                class="rounded-2xl bg-gray-200 p-4 transition"
                data-statut="EN_ATTENTE"
                data-action="
                    dragover->kanban#dragOver
                    dragleave->kanban#dragLeave
                    drop->kanban#drop
                "
            >

                <div class="mb-4 flex items-center justify-between">

                    <h2 class="text-lg font-bold text-gray-800">
                        En attente
                    </h2>

                    <span
                        class="rounded-full bg-white px-3 py-1
                               text-sm font-semibold text-gray-600"
                    >

                        {% set count = 0 %}

                        {% for ordre in ordres %}

                            {% if ordre.statut == 'EN_ATTENTE' %}

                                {% set count = count + 1 %}

                            {% endif %}

                        {% endfor %}

                        {{ count }}

                    </span>

                </div>


                <div class="space-y-4">

                    {% for ordre in ordres %}

                        {% if ordre.statut == 'EN_ATTENTE' %}

                            {{ _self.carte_ordre(ordre) }}

                        {% endif %}

                    {% endfor %}

                </div>

            </div>


            {# ================================================== #}
            {# EN COURS                                            #}
            {# ================================================== #}

            <div
                class="rounded-2xl bg-blue-50 p-4 transition"
                data-statut="EN_COURS"
                data-action="
                    dragover->kanban#dragOver
                    dragleave->kanban#dragLeave
                    drop->kanban#drop
                "
            >

                <div class="mb-4 flex items-center justify-between">

                    <h2 class="text-lg font-bold text-blue-800">
                        En cours
                    </h2>

                    <span
                        class="rounded-full bg-white px-3 py-1
                               text-sm font-semibold text-blue-700"
                    >

                        {% set count = 0 %}

                        {% for ordre in ordres %}

                            {% if ordre.statut == 'EN_COURS' %}

                                {% set count = count + 1 %}

                            {% endif %}

                        {% endfor %}

                        {{ count }}

                    </span>

                </div>


                <div class="space-y-4">

                    {% for ordre in ordres %}

                        {% if ordre.statut == 'EN_COURS' %}

                            {{ _self.carte_ordre(ordre) }}

                        {% endif %}

                    {% endfor %}

                </div>

            </div>


            {# ================================================== #}
            {# TERMINÉS                                            #}
            {# ================================================== #}

            <div
                class="rounded-2xl bg-green-50 p-4 transition"
                data-statut="TERMINE"
                data-action="
                    dragover->kanban#dragOver
                    dragleave->kanban#dragLeave
                    drop->kanban#drop
                "
            >

                <div class="mb-4 flex items-center justify-between">

                    <h2 class="text-lg font-bold text-green-800">
                        Terminés
                    </h2>

                    <span
                        class="rounded-full bg-white px-3 py-1
                               text-sm font-semibold text-green-700"
                    >

                        {% set count = 0 %}

                        {% for ordre in ordres %}

                            {% if ordre.statut == 'TERMINE' %}

                                {% set count = count + 1 %}

                            {% endif %}

                        {% endfor %}

                        {{ count }}

                    </span>

                </div>


                <div class="space-y-4">

                    {% for ordre in ordres %}

                        {% if ordre.statut == 'TERMINE' %}

                            {{ _self.carte_ordre(ordre) }}

                        {% endif %}

                    {% endfor %}

                </div>

            </div>

        </div>

    </div>

</div>


{% macro carte_ordre(ordre) %}

<div
    class="rounded-xl bg-white p-5 shadow-sm
           transition hover:-translate-y-1 hover:shadow-md
           cursor-grab active:cursor-grabbing"
    draggable="true"
    data-action="
        click->kanban#selectionner
        dragstart->kanban#dragStart
        dragend->kanban#dragEnd
    "
    data-id="{{ ordre.id }}"
    data-numero="{{ ordre.numero }}"
    data-csrf-token="{{ csrf_token('kanban_statut') }}"
>

    <div class="flex items-start justify-between gap-3">

        <div>

            <span
                class="inline-flex rounded-full bg-gray-100
                       px-3 py-1 text-xs font-bold text-gray-700"
            >
                {{ ordre.numero }}
            </span>

            <h3 class="mt-3 text-lg font-bold text-gray-900">
                {{ ordre.produit.nom }}
            </h3>

        </div>

        <span
            class="rounded-lg bg-blue-50 px-2 py-1
                   text-xs font-semibold text-blue-700"
        >
            x{{ ordre.quantite }}
        </span>

    </div>


    <div class="mt-4 space-y-1 text-sm text-gray-600">

        <p>

            <span class="font-medium text-gray-800">
                Produit :
            </span>

            {{ ordre.produit.reference }}

        </p>

        <p>

            <span class="font-medium text-gray-800">
                Créé le :
            </span>

            {{ ordre.dateCreation|date('d/m/Y') }}

        </p>

    </div>


    <div class="mt-5">

        <h4 class="mb-3 text-sm font-bold text-gray-800">
            Étapes de fabrication
        </h4>


        <div class="space-y-2">

            {% for etape in ordre.etapeFabrications|sort((a, b) => a.ordre <=> b.ordre) %}

                <div
                    class="rounded-lg border border-gray-200
                           bg-gray-50 p-3"
                >

                    <div
                        class="flex items-center justify-between
                               gap-3"
                    >

                        <div class="flex items-center gap-3">

                            <span
                                class="flex h-7 w-7 shrink-0
                                       items-center justify-center
                                       rounded-full bg-gray-200
                                       text-xs font-bold text-gray-700"
                            >
                                {{ etape.ordre }}
                            </span>

                            <span
                                class="text-sm font-medium
                                       text-gray-700"
                            >
                                {{ etape.nom }}
                            </span>

                        </div>


                        {% if etape.statut == 'TERMINEE' %}

                            <span
                                class="rounded-full bg-green-100
                                       px-2 py-1 text-xs
                                       font-semibold text-green-700"
                            >
                                Terminée
                            </span>

                        {% elseif etape.statut == 'EN_COURS' %}

                            <span
                                class="rounded-full bg-blue-100
                                       px-2 py-1 text-xs
                                       font-semibold text-blue-700"
                            >
                                En cours
                            </span>

                        {% else %}

                            <span
                                class="rounded-full bg-gray-200
                                       px-2 py-1 text-xs
                                       font-semibold text-gray-600"
                            >
                                À faire
                            </span>

                        {% endif %}

                    </div>


                    {% if is_granted('EDIT', ordre) %}

                        <form
                            method="post"
                            action="{{ path(
                                'app_ordre_fabrication_etape_statut',
                                {
                                    id: ordre.id,
                                    etapeId: etape.id
                                }
                            ) }}"
                            class="mt-3"
                        >

                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('modifier_etape') }}"
                            >

                            <label
                                for="statut-{{ etape.id }}"
                                class="sr-only"
                            >
                                Statut de {{ etape.nom }}
                            </label>

                            <div class="flex gap-2">

                                <select
                                    id="statut-{{ etape.id }}"
                                    name="statut"
                                    class="min-w-0 flex-1 rounded-lg
                                           border border-gray-300
                                           bg-white px-3 py-2
                                           text-xs text-gray-700
                                           outline-none
                                           focus:border-blue-500
                                           focus:ring-2
                                           focus:ring-blue-500"
                                >

                                    <option
                                        value="A_FAIRE"
                                        {% if etape.statut == 'A_FAIRE' %}
                                            selected
                                        {% endif %}
                                    >
                                        À faire
                                    </option>

                                    <option
                                        value="EN_COURS"
                                        {% if etape.statut == 'EN_COURS' %}
                                            selected
                                        {% endif %}
                                    >
                                        En cours
                                    </option>

                                    <option
                                        value="TERMINEE"
                                        {% if etape.statut == 'TERMINEE' %}
                                            selected
                                        {% endif %}
                                    >
                                        Terminée
                                    </option>

                                </select>


                                <button
                                    type="submit"
                                    class="rounded-lg bg-blue-600
                                           px-3 py-2 text-xs
                                           font-semibold text-white
                                           transition hover:bg-blue-700"
                                >
                                    Modifier
                                </button>

                            </div>

                        </form>

                    {% endif %}

                </div>

            {% endfor %}

        </div>

    </div>


    <div
        class="mt-5 flex flex-wrap gap-2
               border-t border-gray-100 pt-4"
    >

        {% if is_granted('EDIT', ordre) %}

            <a
                href="{{ path(
                    'app_ordre_fabrication_edit',
                    {id: ordre.id}
                ) }}"
                class="rounded-lg bg-amber-100 px-3 py-2
                       text-xs font-semibold text-amber-700
                       transition hover:bg-amber-200"
            >
                Modifier
            </a>

        {% endif %}


        {% if is_granted('DELETE', ordre) %}

            <form
                method="post"
                action="{{ path(
                    'app_ordre_fabrication_delete',
                    {id: ordre.id}
                ) }}"
                onsubmit="return confirm(
                    'Voulez-vous vraiment supprimer cet ordre de fabrication ?'
                );"
            >

                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('supprimer_ordre') }}"
                >

                <button
                    type="submit"
                    class="rounded-lg bg-red-100 px-3 py-2
                           text-xs font-semibold text-red-700
                           transition hover:bg-red-200"
                >
                    Supprimer
                </button>

            </form>

        {% endif %}

    </div>

</div>

{% endmacro %}

{% endblock %}