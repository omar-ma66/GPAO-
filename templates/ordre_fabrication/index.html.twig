</div>

{# ================================================================
RECHERCHE + HISTORIQUE
================================================================ #}

<script>

document.addEventListener('DOMContentLoaded', function () {

    const recherche =
        document.getElementById('recherche-of');

    const reset =
        document.getElementById('reset-recherche-of');

    const viderHistorique =
        document.getElementById('vider-historique-of');

    const resultat =
        document.getElementById('resultat-of');

    const aucunResultat =
        document.getElementById('aucun-resultat-recherche');

    const datalist =
        document.getElementById('historique-recherche-of');

    const lignes =
        Array.from(
            document.querySelectorAll('.ligne-of')
        );


    /*
     * ============================================================
     * MÉMOIRE DES RECHERCHES
     * ============================================================
     */

    const cleHistorique =
        'gpao_recherche_of_history';

    const maximumHistorique = 10;


    function recupererHistorique() {

        try {

            const historique =
                JSON.parse(
                    localStorage.getItem(cleHistorique)
                    || '[]'
                );

            if (!Array.isArray(historique)) {
                return [];
            }

            return historique;

        } catch (error) {

            console.error(
                'Impossible de lire l’historique des recherches.',
                error
            );

            return [];
        }
    }


    function sauvegarderHistorique(valeur) {

        valeur = valeur.trim();

        if (!valeur) {
            return;
        }

        let historique =
            recupererHistorique();

        /*
         * Si la recherche existe déjà,
         * on la retire afin de la remettre
         * en première position.
         */
        historique =
            historique.filter(function (element) {

                return element.toLowerCase()
                    !== valeur.toLowerCase();

            });


        historique.unshift(valeur);


        /*
         * On conserve uniquement les
         * dernières recherches.
         */
        historique =
            historique.slice(
                0,
                maximumHistorique
            );


        localStorage.setItem(
            cleHistorique,
            JSON.stringify(historique)
        );


        afficherHistorique();
    }


    function afficherHistorique() {

        const historique =
            recupererHistorique();


        /*
         * On vide le datalist avant
         * de le reconstruire.
         */
        datalist.innerHTML = '';


        historique.forEach(function (valeur) {

            const option =
                document.createElement('option');

            option.value = valeur;

            datalist.appendChild(option);

        });


        /*
         * Le bouton "Vider l'historique"
         * n'est visible que lorsqu'il existe
         * réellement un historique.
         */
        viderHistorique.classList.toggle(
            'hidden',
            historique.length === 0
        );
    }


    function viderTouteLaMemoire() {

        localStorage.removeItem(
            cleHistorique
        );

        datalist.innerHTML = '';

        viderHistorique.classList.add(
            'hidden'
        );
    }


    /*
     * ============================================================
     * FILTRAGE DES OF
     * ============================================================
     */

    function filtrerOF() {

        const texte =
            recherche.value
                .trim()
                .toLowerCase();


        let nombreVisible = 0;


        lignes.forEach(function (ligne) {

            const numero =
                ligne.dataset.recherche || '';


            const visible =
                texte === ''
                || numero.includes(texte);


            ligne.classList.toggle(
                'hidden',
                !visible
            );


            if (visible) {
                nombreVisible++;
            }

        });


        resultat.textContent =
            nombreVisible + ' OF';


        reset.classList.toggle(
            'hidden',
            texte === ''
        );


        aucunResultat.classList.toggle(
            'hidden',
            texte === ''
            || nombreVisible !== 0
        );
    }


    /*
     * ============================================================
     * SAISIE DE RECHERCHE
     * ============================================================
     */

    recherche.addEventListener(
        'input',
        filtrerOF
    );


    /*
     * Appuyer sur Entrée mémorise
     * la recherche.
     */
    recherche.addEventListener(
        'keydown',
        function (event) {

            if (event.key === 'Enter') {

                sauvegarderHistorique(
                    recherche.value
                );

            }

        }
    );


    /*
     * Quitter la barre mémorise également
     * la recherche.
     */
    recherche.addEventListener(
        'blur',
        function () {

            sauvegarderHistorique(
                recherche.value
            );

        }
    );


    /*
     * ============================================================
     * RÉINITIALISER LA RECHERCHE ACTUELLE
     * ============================================================
     */

    reset.addEventListener(
        'click',
        function () {

            recherche.value = '';

            filtrerOF();

            recherche.focus();

        }
    );


    /*
     * ============================================================
     * VIDER TOUT L'HISTORIQUE
     * ============================================================
     */

    viderHistorique.addEventListener(
        'click',
        function () {

            if (
                !confirm(
                    'Voulez-vous supprimer tout l’historique des recherches ?'
                )
            ) {
                return;
            }


            viderTouteLaMemoire();


            /*
             * On repart également avec
             * une recherche vide.
             */
            recherche.value = '';

            filtrerOF();

            recherche.focus();

        }
    );


    /*
     * ============================================================
     * INITIALISATION
     * ============================================================
     */

    afficherHistorique();

    filtrerOF();

});

</script>

{% endblock %}
