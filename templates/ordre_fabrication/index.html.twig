{% extends 'base.html.twig' %}

{% block title %}Ordres de fabrication{% endblock %}

{% block body %}

<div
    class="mx-auto max-w-7xl px-3 py-4"
    data-controller="kanban"
>

```
{# ============================================================
   EN-TÊTE
   ============================================================ #}

<div class="mb-3 flex flex-wrap items-center justify-between gap-2">

    <div>
        <h1 class="text-xl font-bold text-slate-800">
            Ordres de fabrication
        </h1>

        <p class="text-xs text-slate-500">
            Gestion des ordres de fabrication
        </p>
    </div>

    <a
        href="{{ path('app_ordre_fabrication_new') }}"
        class="rounded-lg bg-blue-600 px-3 py-2 text-xs font-semibold text-white shadow hover:bg-blue-700"
    >
        + Nouvel OF
    </a>

</div>


{# ============================================================
   MESSAGES FLASH
   ============================================================ #}

{% for message in app.flashes('success') %}
    <div class="mb-2 rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-xs text-green-700">
        {{ message }}
    </div>
{% endfor %}

{% for message in app.flashes('error') %}
    <div class="mb-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">
        {{ message }}
    </div>
{% endfor %}


{# ============================================================
   RECHERCHE
   ============================================================ #}

<div class="mb-3 flex flex-wrap items-center gap-2">

    <div class="relative min-w-[250px] flex-1">

        <input
            type="text"
            id="recherche-of"
            list="historique-recherche-of"
            placeholder="Rechercher un numéro d'OF..."
            autocomplete="off"
            class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
        >

        <datalist id="historique-recherche-of"></datalist>

    </div>

    <button
        type="button"
        id="reset-recherche-of"
        class="hidden rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50"
    >
        Réinitialiser
    </button>

    <button
        type="button"
        id="vider-historique-of"
        class="hidden rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-600 hover:bg-red-100"
    >
        Vider l'historique
    </button>

    <span
        id="resultat-of"
        class="whitespace-nowrap text-xs font-semibold text-slate-500"
    >
        {{ ordres|length }} OF
    </span>

</div>


{# ============================================================
   KANBAN : EN ATTENTE
   ============================================================ #}

{% set compteurAttente = 0 %}

{% for ordre in ordres %}
    {% if ordre.statut == 'EN_ATTENTE' %}
        {% set compteurAttente = compteurAttente + 1 %}
    {% endif %}
{% endfor %}

<section class="mb-3 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">

    <div class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-3 py-2">

        <div class="flex items-center gap-2">

            <span class="h-2.5 w-2.5 rounded-full bg-slate-400"></span>

            <h2 class="text-xs font-bold uppercase tracking-wide text-slate-700">
                En attente
            </h2>

            <span class="rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-bold text-slate-600">
                {{ compteurAttente }}
            </span>

        </div>

        <span class="text-[10px] text-slate-400">
            Glisser un OF ici
        </span>

    </div>

    <div
        class="max-h-64 overflow-auto"
        data-statut="EN_ATTENTE"
        data-action="dragover->kanban#dragOver dragleave->kanban#dragLeave drop->kanban#drop"
    >

        <table class="w-full min-w-[1050px] text-xs">

            <thead class="sticky top-0 z-10 bg-white shadow-sm">

                <tr class="border-b border-slate-200 text-left text-[10px] uppercase tracking-wide text-slate-400">

                    <th class="w-28 px-3 py-2">
                        OF
                    </th>

                    <th class="w-40 px-2 py-2">
                        Produit
                    </th>

                    <th class="w-14 px-2 py-2 text-center">
                        Qté
                    </th>

                    <th class="px-2 py-2">
                        Étapes
                    </th>

                    <th class="w-48 px-2 py-2">
                        Actions
                    </th>

                </tr>

            </thead>

            <tbody>

            {% for ordre in ordres %}

                {% if ordre.statut == 'EN_ATTENTE' %}

                    {% set etapes = ordre.etapeFabrications|sort((a, b) => a.ordre <=> b.ordre) %}

                    <tr
                        class="ligne-of cursor-grab border-b border-slate-100 transition hover:bg-slate-50 active:cursor-grabbing"
                        draggable="true"
                        data-id="{{ ordre.id }}"
                        data-numero="{{ ordre.numero }}"
                        data-recherche="{{ ordre.numero|lower }}"
                        data-csrf-token="{{ csrf_token('kanban_statut') }}"
                        data-action="
                            click->kanban#selectionner
                            dragstart->kanban#dragStart
                            dragend->kanban#dragEnd
                        "
                    >

                        <td class="px-3 py-2 font-bold text-slate-800">
                            {{ ordre.numero }}
                        </td>

                        <td class="px-2 py-2 text-slate-700">
                            {{ ordre.produit.nom }}
                        </td>

                        <td class="px-2 py-2 text-center font-semibold text-slate-700">
                            {{ ordre.quantite }}
                        </td>

                        <td class="px-2 py-1">

                            {% if etapes is empty %}

                                <span class="text-[10px] italic text-slate-400">
                                    Aucune étape
                                </span>

                            {% else %}

                                <div class="flex items-center gap-1.5 whitespace-nowrap">

                                    {% for etape in etapes %}

                                        <div class="flex items-center gap-1 rounded-md border border-slate-200 bg-slate-50 px-1.5 py-1">

                                            <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-700 text-[9px] font-bold text-white">
                                                {{ etape.ordre }}
                                            </span>

                                            <span
                                                class="max-w-[105px] truncate text-[10px] font-semibold text-slate-700"
                                                title="{{ etape.nom }}"
                                            >
                                                {{ etape.nom }}
                                            </span>

                                            {% if is_granted('EDIT', ordre) %}

                                                <form
                                                    method="post"
                                                    action="{{ path('app_ordre_fabrication_etape_statut', {
                                                        id: ordre.id,
                                                        etapeId: etape.id
                                                    }) }}"
                                                    class="inline-flex"
                                                    onclick="event.stopPropagation();"
                                                >

                                                    <input
                                                        type="hidden"
                                                        name="_token"
                                                        value="{{ csrf_token('modifier_etape') }}"
                                                    >

                                                    <select
                                                        name="statut"
                                                        title="{{ etape.nom }}"
                                                        class="w-[72px] rounded border border-slate-300 bg-white px-1 py-0.5 text-[9px] text-slate-600 outline-none focus:border-blue-500"
                                                        onchange="event.stopPropagation(); this.form.submit()"
                                                    >

                                                        <option value="A_FAIRE" {{ etape.statut == 'A_FAIRE' ? 'selected' }}>
                                                            À faire
                                                        </option>

                                                        <option value="EN_COURS" {{ etape.statut == 'EN_COURS' ? 'selected' }}>
                                                            En cours
                                                        </option>

                                                        <option value="TERMINEE" {{ etape.statut == 'TERMINEE' ? 'selected' }}>
                                                            Terminée
                                                        </option>

                                                    </select>

                                                </form>

                                            {% else %}

                                                <span class="rounded bg-slate-100 px-1 py-0.5 text-[9px] text-slate-500">
                                                    {{ etape.statut|replace({
                                                        'A_FAIRE': 'À faire',
                                                        'EN_COURS': 'En cours',
                                                        'TERMINEE': 'Terminée'
                                                    }) }}
                                                </span>

                                            {% endif %}

                                        </div>

                                    {% endfor %}

                                </div>

                            {% endif %}

                        </td>

                        <td class="px-2 py-1">

                            <div class="flex flex-wrap items-center gap-1">

                                {% if is_granted('EDIT', ordre) %}

                                    <a
                                        href="{{ path('app_ordre_fabrication_configurer_etapes', {id: ordre.id}) }}"
                                        class="rounded bg-slate-100 px-2 py-1 text-[10px] font-semibold text-slate-600 hover:bg-slate-200"
                                        onclick="event.stopPropagation();"
                                    >
                                        Étapes
                                    </a>

                                    <a
                                        href="{{ path('app_ordre_fabrication_edit', {id: ordre.id}) }}"
                                        class="rounded bg-blue-50 px-2 py-1 text-[10px] font-semibold text-blue-600 hover:bg-blue-100"
                                        onclick="event.stopPropagation();"
                                    >
                                        Modifier
                                    </a>

                                    {% if ordre.statut == 'EN_ATTENTE' and ordre.dateArchivage is null %}

                                        <form
                                            method="post"
                                            action="{{ path('app_ordre_fabrication_supprimer', {id: ordre.id}) }}"
                                            class="inline"
                                            onclick="event.stopPropagation();"
                                        >

                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('supprimer_' ~ ordre.id) }}"
                                            >

                                            <button
                                                type="submit"
                                                class="rounded bg-red-50 px-2 py-1 text-[10px] font-semibold text-red-600 hover:bg-red-100"
                                                onclick="return confirm('Supprimer cet ordre de fabrication ?');"
                                            >
                                                Supprimer
                                            </button>

                                        </form>

                                    {% endif %}

                                {% endif %}

                            </div>

                        </td>

                    </tr>

                {% endif %}

            {% endfor %}

            </tbody>

        </table>

    </div>

</section>


