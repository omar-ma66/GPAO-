{% extends 'base.html.twig' %}

{% block title %}Ordres de fabrication{% endblock %}

{% macro carte_ordre(ordre) %}


<div
    class="rounded-xl bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md cursor-grab active:cursor-grabbing"
    draggable="true"
    data-action="
        click->kanban#selectionner
        dragstart->kanban#dragStart
        dragend->kanban#dragEnd
    "
    data-id="{{ ordre.id }}"
    data-numero="{{ ordre.numero }}"
    data-csrf-token="{{ csrf_token('kanban_statut') }}"
>

    <div class="flex items-start justify-between gap-3">

        <div>
            <div class="text-lg font-bold text-slate-900">
                {{ ordre.numero }}
            </div>

            <div class="mt-1 text-sm text-slate-600">
                {{ ordre.produit.nom }}
            </div>
        </div>

        <div class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">
            {{ ordre.quantite }} unités
        </div>

    </div>

    <div class="mt-4 space-y-2">

        {% set etapes = ordre.etapeFabrications|sort((a, b) => a.ordre <=> b.ordre) %}

        {% if etapes is empty %}

            <div class="rounded-lg border border-dashed border-slate-300 px-3 py-3 text-sm text-slate-500">
                Aucune étape configurée.
            </div>

        {% else %}

            {% for etape in etapes %}

                <div class="rounded-lg border border-slate-200 bg-slate-50 p-3">

                    <div class="flex items-center justify-between gap-3">

                        <div class="flex min-w-0 items-center gap-2">

                            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-900 text-xs font-bold text-white">
                                {{ etape.ordre }}
                            </span>

                            <span class="truncate text-sm font-semibold text-slate-800">
                                {{ etape.nom }}
                            </span>

                        </div>

                        <span class="shrink-0 text-xs font-semibold text-slate-500">
                            {{ etape.statut }}
                        </span>

                    </div>

                    {% if is_granted('EDIT', ordre) %}

                        <form
                            method="post"
                            action="{{ path('app_ordre_fabrication_etape_statut', {
                                id: ordre.id,
                                etapeId: etape.id
                            }) }}"
                            class="mt-3"
                        >

                            <input
                                type="hidden"
                                name="_token"
                                value="{{ csrf_token('modifier_etape') }}"
                            >

                            <select
                                name="statut"
                                class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"
                                onchange="this.form.submit()"
                            >

                                <option
                                    value="A_FAIRE"
                                    {{ etape.statut == 'A_FAIRE' ? 'selected' : '' }}
                                >
                                    À faire
                                </option>

                                <option
                                    value="EN_COURS"
                                    {{ etape.statut == 'EN_COURS' ? 'selected' : '' }}
                                >
                                    En cours
                                </option>

                                <option
                                    value="TERMINEE"
                                    {{ etape.statut == 'TERMINEE' ? 'selected' : '' }}
                                >
                                    Terminée
                                </option>

                            </select>

                        </form>

                    {% endif %}

                </div>

            {% endfor %}

        {% endif %}

    </div>

    <div class="mt-5 flex flex-wrap gap-2">

        {% if is_granted('EDIT', ordre) %}

            <a
                href="{{ path('app_ordre_fabrication_configurer_etapes', {
                    id: ordre.id
                }) }}"
                class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                onclick="event.stopPropagation();"
            >
                Étapes
            </a>

            <a
                href="{{ path('app_ordre_fabrication_edit', {
                    id: ordre.id
                }) }}"
                class="rounded-lg border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
                onclick="event.stopPropagation();"
            >
                Modifier
            </a>

        {% endif %}

        {% if ordre.statut == 'TERMINE' and ordre.dateArchivage is null %}

            <form
                method="post"
                action="{{ path('app_ordre_fabrication_archiver', {
                    id: ordre.id
                }) }}"
                class="inline"
                onclick="event.stopPropagation();"
                onsubmit="event.stopPropagation(); return confirm('Voulez-vous archiver cet ordre de fabrication ?');"
            >

                <input
                    type="hidden"
                    name="_token"
                    value="{{ csrf_token('archiver_' ~ ordre.id) }}"
                >

                <button
                    type="submit"
                    class="rounded-lg border border-amber-200 px-3 py-2 text-sm font-semibold text-amber-700 hover:bg-amber-50"
                >
                    Archiver
                </button>

            </form>

        {% endif %}

    </div>

</div>


{% endmacro %}

{% block body %}

<div
    class="mx-auto max-w-7xl px-4 py-8"
    data-controller="kanban"
>


<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

    <div>

        <h1 class="text-3xl font-bold text-slate-900">
            Ordres de fabrication
        </h1>

        <p class="mt-1 text-slate-600">
            Suivez l’avancement de votre production.
        </p>

    </div>

    <a
        href="{{ path('app_ordre_fabrication_new') }}"
        class="inline-flex items-center justify-center rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-700"
    >
        + Nouvel OF
    </a>

</div>

{% for message in app.flashes('success') %}

    <div class="mb-4 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-green-800">
        {{ message }}
    </div>

{% endfor %}

{% for message in app.flashes('error') %}

    <div class="mb-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-red-800">
        {{ message }}
    </div>

{% endfor %}

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

    <!-- EN ATTENTE -->

    <div
        class="min-h-[300px] rounded-2xl bg-slate-100 p-4"
        data-statut="EN_ATTENTE"
        data-action="dragover->kanban#dragOver dragleave->kanban#dragLeave drop->kanban#drop"
    >

        <div class="mb-4 flex items-center justify-between">

            <h2 class="font-bold text-slate-800">
                En attente
            </h2>

            <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-600">

                {% set count = 0 %}

                {% for ordre in ordres %}

                    {% if ordre.statut == 'EN_ATTENTE' %}
                        {% set count = count + 1 %}
                    {% endif %}

                {% endfor %}

                {{ count }}

            </span>

        </div>

        <div class="space-y-4">

            {% for ordre in ordres %}

                {% if ordre.statut == 'EN_ATTENTE' %}
                    {{ _self.carte_ordre(ordre) }}
                {% endif %}

            {% endfor %}

        </div>

    </div>

    <!-- EN COURS -->

    <div
        class="min-h-[300px] rounded-2xl bg-blue-50 p-4"
        data-statut="EN_COURS"
        data-action="dragover->kanban#dragOver dragleave->kanban#dragLeave drop->kanban#drop"
    >

        <div class="mb-4 flex items-center justify-between">

            <h2 class="font-bold text-slate-800">
                En cours
            </h2>

            <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-600">

                {% set count = 0 %}

                {% for ordre in ordres %}

                    {% if ordre.statut == 'EN_COURS' %}
                        {% set count = count + 1 %}
                    {% endif %}

                {% endfor %}

                {{ count }}

            </span>

        </div>

        <div class="space-y-4">

            {% for ordre in ordres %}

                {% if ordre.statut == 'EN_COURS' %}
                    {{ _self.carte_ordre(ordre) }}
                {% endif %}

            {% endfor %}

        </div>

    </div>

    <!-- TERMINE -->

    <div
        class="min-h-[300px] rounded-2xl bg-green-50 p-4"
        data-statut="TERMINE"
        data-action="dragover->kanban#dragOver dragleave->kanban#dragLeave drop->kanban#drop"
    >

        <div class="mb-4 flex items-center justify-between">

            <h2 class="font-bold text-slate-800">
                Terminés
            </h2>

            <span class="rounded-full bg-white px-3 py-1 text-xs font-semibold text-slate-600">

                {% set count = 0 %}

                {% for ordre in ordres %}

                    {% if ordre.statut == 'TERMINE' %}
                        {% set count = count + 1 %}
                    {% endif %}

                {% endfor %}

                {{ count }}

            </span>

        </div>

        <div class="space-y-4">

            {% for ordre in ordres %}

                {% if ordre.statut == 'TERMINE' %}
                    {{ _self.carte_ordre(ordre) }}
                {% endif %}

            {% endfor %}

        </div>

    </div>

</div>


</div>

{% endblock %}
