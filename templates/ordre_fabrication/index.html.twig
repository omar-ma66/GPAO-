        <div class="flex items-center justify-between border-b border-slate-200 bg-green-50 px-3 py-2">

            <div class="flex items-center gap-2">

                <span class="h-2.5 w-2.5 rounded-full bg-green-500"></span>

                <h2 class="text-sm font-bold text-green-800">
                    Terminé
                </h2>

            </div>

            <span class="rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-bold text-green-700">

                {% set compteurTermine = 0 %}

                {% for ordre in ordres %}

                    {% if ordre.statut == 'TERMINE' %}
                        {% set compteurTermine = compteurTermine + 1 %}
                    {% endif %}

                {% endfor %}

                {{ compteurTermine }}

            </span>

        </div>

        <div
            class="max-h-64 overflow-auto"
            data-statut="TERMINE"
            data-action="dragover->kanban#dragOver dragleave->kanban#dragLeave drop->kanban#drop"
        >

            <table class="w-full min-w-[900px] text-xs">

                <thead class="sticky top-0 z-10 bg-slate-50 text-[10px] uppercase text-slate-500">

                    <tr>

                        <th class="w-28 px-2 py-1.5 text-left">
                            OF
                        </th>

                        <th class="w-40 px-2 py-1.5 text-left">
                            Produit
                        </th>

                        <th class="w-16 px-2 py-1.5 text-center">
                            Qté
                        </th>

                        <th class="px-2 py-1.5 text-left">
                            Étapes
                        </th>

                        <th class="w-40 px-2 py-1.5 text-right">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody class="divide-y divide-slate-100">

                    {% set aucuneTermine = true %}

                    {% for ordre in ordres %}

                        {% if ordre.statut == 'TERMINE' %}

                            {% set aucuneTermine = false %}

                            <tr
                                class="ligne-of cursor-grab transition hover:bg-slate-50 active:cursor-grabbing"
                                draggable="true"
                                data-id="{{ ordre.id }}"
                                data-numero="{{ ordre.numero }}"
                                data-recherche="{{ ordre.numero|lower }}"
                                data-csrf-token="{{ csrf_token('kanban_statut') }}"
                                data-action="
                                    click->kanban#selectionner
                                    dragstart->kanban#dragStart
                                    dragend->kanban#dragEnd
                                "
                            >

                                <td class="whitespace-nowrap px-2 py-1.5 font-bold text-slate-900">
                                    {{ ordre.numero }}
                                </td>

                                <td class="px-2 py-1.5">

                                    <div class="font-semibold text-slate-800">
                                        {{ ordre.produit.nom }}
                                    </div>

                                    {% if ordre.produit.reference is defined and ordre.produit.reference %}
                                        <div class="text-[10px] text-slate-400">
                                            {{ ordre.produit.reference }}
                                        </div>
                                    {% endif %}

                                </td>

                                <td class="whitespace-nowrap px-2 py-1.5 text-center font-semibold text-slate-700">
                                    {{ ordre.quantite }}
                                </td>

                                <td class="px-2 py-1.5">

                                    {% set etapes = ordre.etapeFabrications|sort((a, b) => a.ordre <=> b.ordre) %}

                                    {% if etapes is empty %}

                                        <span class="text-[10px] italic text-slate-400">
                                            Aucune étape
                                        </span>

                                    {% else %}

                                        <div class="flex items-center gap-1 whitespace-nowrap">

                                            {% for etape in etapes %}

                                                <span
                                                    class="flex h-5 items-center gap-1 rounded bg-green-50 px-1.5 text-[10px] font-semibold text-green-700"
                                                    title="{{ etape.nom }}"
                                                >
                                                    <span class="font-bold">
                                                        {{ etape.ordre }}
                                                    </span>
                                                    {{ etape.nom }}
                                                </span>

                                            {% endfor %}

                                        </div>

                                    {% endif %}

                                </td>

                                <td class="px-2 py-1.5">

                                    <div
                                        class="flex justify-end gap-1"
                                        onclick="event.stopPropagation();"
                                    >

                                        {% if is_granted('EDIT', ordre) %}

                                            <a
                                                href="{{ path('app_ordre_fabrication_configurer_etapes', {
                                                    id: ordre.id
                                                }) }}"
                                                class="rounded border border-slate-300 px-1.5 py-1 text-[10px] font-semibold text-slate-700 hover:bg-slate-50"
                                            >
                                                Étapes
                                            </a>

                                            <a
                                                href="{{ path('app_ordre_fabrication_edit', {
                                                    id: ordre.id
                                                }) }}"
                                                class="rounded border border-slate-300 px-1.5 py-1 text-[10px] font-semibold text-slate-700 hover:bg-slate-50"
                                            >
                                                Modifier
                                            </a>

                                        {% endif %}

                                        {% if ordre.statut == 'TERMINE' and ordre.dateArchivage is null %}

                                            <form
                                                method="post"
                                                action="{{ path('app_ordre_fabrication_archiver', {
                                                    id: ordre.id
                                                }) }}"
                                                onsubmit="return confirm('Voulez-vous archiver cet ordre de fabrication ?');"
                                            >

                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('archiver_' ~ ordre.id) }}"
                                                >

                                                <button
                                                    type="submit"
                                                    class="rounded border border-amber-200 px-1.5 py-1 text-[10px] font-semibold text-amber-700 hover:bg-amber-50"
                                                >
                                                    Archiver
                                                </button>

                                            </form>

                                        {% endif %}

                                    </div>

                                </td>

                            </tr>

                        {% endif %}

                    {% endfor %}

                    {% if aucuneTermine %}

                        <tr>

                            <td
                                colspan="5"
                                class="px-3 py-4 text-center text-[10px] italic text-slate-400"
                            >
                                Aucun OF terminé.
                            </td>

                        </tr>

                    {% endif %}

                </tbody>

            </table>

        </div>

    </section>


    {# ============================================================ #}
    {# AUCUN RÉSULTAT DE RECHERCHE #}
    {# ============================================================ #}

    <div
        id="aucun-resultat-recherche"
        class="hidden rounded-lg border border-slate-200 bg-white px-3 py-4 text-center text-xs text-slate-500"
    >
        Aucun OF ne correspond à votre recherche.
    </div>

</div>


{# ================================================================ #}
{# RECHERCHE PAR NUMÉRO D'OF                                       #}
{# ================================================================ #}

<script>

    document.addEventListener('DOMContentLoaded', function () {

        const recherche = document.getElementById('recherche-of');
        const resultat = document.getElementById('resultat-of');
        const reset = document.getElementById('reset-recherche-of');
        const aucunResultat = document.getElementById('aucun-resultat-recherche');

        const lignes = Array.from(
            document.querySelectorAll('.ligne-of')
        );

        function filtrerOF() {

            const texte = recherche.value
                .trim()
                .toLowerCase();

            let nombreVisible = 0;

            lignes.forEach(function (ligne) {

                const numero = (
                    ligne.dataset.recherche || ''
                ).toLowerCase();

                const visible =
                    texte === ''
                    || numero.includes(texte);

                ligne.classList.toggle(
                    'hidden',
                    !visible
                );

                if (visible) {
                    nombreVisible++;
                }

            });

            resultat.textContent =
                nombreVisible + ' OF';

            reset.classList.toggle(
                'hidden',
                texte === ''
            );

            aucunResultat.classList.toggle(
                'hidden',
                nombreVisible !== 0
            );

        }

        recherche.addEventListener(
            'input',
            filtrerOF
        );

        reset.addEventListener(
            'click',
            function () {

                recherche.value = '';

                filtrerOF();

                recherche.focus();

            }
        );

    });

</script>

{% endblock %}