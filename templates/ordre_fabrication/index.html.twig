{% extends 'base.html.twig' %}

{% block title %}Ordres de fabrication{% endblock %}

{% block body %}

<div
    class="mx-auto max-w-7xl px-3 py-4"
    data-controller="kanban"
>

    {# ============================================================ #}
    {# EN-TÊTE #}
    {# ============================================================ #}

    <div class="mb-4 flex items-center justify-between gap-3">

        <div>
            <h1 class="text-xl font-bold text-slate-900">
                Ordres de fabrication
            </h1>

            <p class="text-xs text-slate-500">
                Suivez l’avancement de votre production.
            </p>
        </div>

        <a
            href="{{ path('app_ordre_fabrication_new') }}"
            class="shrink-0 rounded-lg bg-slate-900 px-3 py-2 text-xs font-semibold text-white hover:bg-slate-700"
        >
            + Nouvel OF
        </a>

    </div>


    {# ============================================================ #}
    {# MESSAGES FLASH #}
    {# ============================================================ #}

    {% for message in app.flashes('success') %}
        <div class="mb-3 rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-xs text-green-800">
            {{ message }}
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="mb-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-800">
            {{ message }}
        </div>
    {% endfor %}


    {# ============================================================ #}
    {# RECHERCHE OF #}
    {# ============================================================ #}

    <div class="mb-4 flex items-center gap-2">

        <div class="relative flex-1">

            <input
                id="recherche-of"
                type="search"
                placeholder="Rechercher un numéro d’OF..."
                autocomplete="off"
                class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-700 outline-none focus:border-slate-500 focus:ring-1 focus:ring-slate-300"
            >

        </div>

        <span
            id="resultat-of"
            class="shrink-0 text-xs font-semibold text-slate-500"
        >
            {{ ordres|length }} OF
        </span>

        <button
            type="button"
            id="reset-recherche-of"
            class="hidden shrink-0 rounded-lg border border-slate-300 px-2.5 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-50"
        >
            Effacer
        </button>

    </div>


    {# ============================================================ #}
    {# KANBAN : EN ATTENTE #}
    {# ============================================================ #}

    <section class="mb-3 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">

        <div class="flex items-center justify-between border-b border-slate-200 bg-amber-50 px-3 py-2">

            <div class="flex items-center gap-2">

                <span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span>

                <h2 class="text-sm font-bold text-amber-800">
                    En attente
                </h2>

            </div>

            <span
                id="compteur-en-attente"
                class="rounded-full bg-amber-100 px-2 py-0.5 text-[10px] font-bold text-amber-700"
            >
                {% set compteurAttente = 0 %}
                {% for ordre in ordres %}
                    {% if ordre.statut == 'EN_ATTENTE' %}
                        {% set compteurAttente = compteurAttente + 1 %}
                    {% endif %}
                {% endfor %}
                {{ compteurAttente }}
            </span>

        </div>

        <div
            class="max-h-64 overflow-auto"
            data-statut="EN_ATTENTE"
            data-action="dragover->kanban#dragOver dragleave->kanban#dragLeave drop->kanban#drop"
        >

            <table class="w-full min-w-[900px] text-xs">

                <thead class="sticky top-0 z-10 bg-slate-50 text-[10px] uppercase text-slate-500">

                    <tr>

                        <th class="w-28 px-2 py-1.5 text-left">
                            OF
                        </th>

                        <th class="w-40 px-2 py-1.5 text-left">
                            Produit
                        </th>

                        <th class="w-16 px-2 py-1.5 text-center">
                            Qté
                        </th>

                        <th class="px-2 py-1.5 text-left">
                            Étapes
                        </th>

                        <th class="w-40 px-2 py-1.5 text-right">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody class="divide-y divide-slate-100">

                    {% set aucuneAttente = true %}

                    {% for ordre in ordres %}

                        {% if ordre.statut == 'EN_ATTENTE' %}

                            {% set aucuneAttente = false %}

                            <tr
                                class="ligne-of cursor-grab transition hover:bg-slate-50 active:cursor-grabbing"
                                draggable="true"
                                data-id="{{ ordre.id }}"
                                data-numero="{{ ordre.numero }}"
                                data-recherche="{{ ordre.numero|lower }}"
                                data-csrf-token="{{ csrf_token('kanban_statut') }}"
                                data-action="
                                    click->kanban#selectionner
                                    dragstart->kanban#dragStart
                                    dragend->kanban#dragEnd
                                "
                            >

                                <td class="whitespace-nowrap px-2 py-1.5 font-bold text-slate-900">
                                    {{ ordre.numero }}
                                </td>

                                <td class="px-2 py-1.5">

                                    <div class="font-semibold text-slate-800">
                                        {{ ordre.produit.nom }}
                                    </div>

                                    {% if ordre.produit.reference is defined and ordre.produit.reference %}
                                        <div class="text-[10px] text-slate-400">
                                            {{ ordre.produit.reference }}
                                        </div>
                                    {% endif %}

                                </td>

                                <td class="whitespace-nowrap px-2 py-1.5 text-center font-semibold text-slate-700">
                                    {{ ordre.quantite }}
                                </td>

                                <td class="px-2 py-1.5">

                                    {% set etapes = ordre.etapeFabrications|sort((a, b) => a.ordre <=> b.ordre) %}

                                    {% if etapes is empty %}

                                        <span class="text-[10px] italic text-slate-400">
                                            Aucune étape
                                        </span>

                                    {% else %}

                                        <div class="flex items-center gap-1 whitespace-nowrap">

                                            {% for etape in etapes %}

                                                <form
                                                    method="post"
                                                    action="{{ path('app_ordre_fabrication_etape_statut', {
                                                        id: ordre.id,
                                                        etapeId: etape.id
                                                    }) }}"
                                                    class="flex items-center gap-1"
                                                    onclick="event.stopPropagation();"
                                                >

                                                    <input
                                                        type="hidden"
                                                        name="_token"
                                                        value="{{ csrf_token('modifier_etape') }}"
                                                    >

                                                    <span
                                                        class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-slate-700 text-[9px] font-bold text-white"
                                                        title="{{ etape.nom }}"
                                                    >
                                                        {{ etape.ordre }}
                                                    </span>

                                                    {% if is_granted('EDIT', ordre) %}

                                                        <select
                                                            name="statut"
                                                            title="{{ etape.nom }}"
                                                            class="w-24 rounded border border-slate-300 bg-white px-1 py-0.5 text-[10px]"
                                                            onchange="event.stopPropagation(); this.form.submit()"
                                                        >

                                                            <option
                                                                value="A_FAIRE"
                                                                {{ etape.statut == 'A_FAIRE' ? 'selected' : '' }}
                                                            >
                                                                À faire
                                                            </option>

                                                            <option
                                                                value="EN_COURS"
                                                                {{ etape.statut == 'EN_COURS' ? 'selected' : '' }}
                                                            >
                                                                En cours
                                                            </option>

                                                            <option
                                                                value="TERMINEE"
                                                                {{ etape.statut == 'TERMINEE' ? 'selected' : '' }}
                                                            >
                                                                Terminée
                                                            </option>

                                                        </select>

                                                    {% else %}

                                                        <span
                                                            class="max-w-24 truncate text-[10px] text-slate-500"
                                                            title="{{ etape.nom }}"
                                                        >
                                                            {{ etape.nom }}
                                                        </span>

                                                    {% endif %}

                                                </form>

                                            {% endfor %}

                                        </div>

                                    {% endif %}

                                </td>

                                <td class="px-2 py-1.5">

                                    <div
                                        class="flex justify-end gap-1"
                                        onclick="event.stopPropagation();"
                                    >

                                        {% if is_granted('EDIT', ordre) %}

                                            <a
                                                href="{{ path('app_ordre_fabrication_configurer_etapes', {
                                                    id: ordre.id
                                                }) }}"
                                                class="rounded border border-slate-300 px-1.5 py-1 text-[10px] font-semibold text-slate-700 hover:bg-slate-50"
                                            >
                                                Étapes
                                            </a>

                                            <a
                                                href="{{ path('app_ordre_fabrication_edit', {
                                                    id: ordre.id
                                                }) }}"
                                                class="rounded border border-slate-300 px-1.5 py-1 text-[10px] font-semibold text-slate-700 hover:bg-slate-50"
                                            >
                                                Modifier
                                            </a>

                                            <form
                                                method="post"
                                                action="{{ path('app_ordre_fabrication_supprimer', {
                                                    id: ordre.id
                                                }) }}"
                                                onsubmit="return confirm('Voulez-vous vraiment supprimer cet ordre de fabrication ? Cette action est irréversible.');"
                                            >

                                                <input
                                                    type="hidden"
                                                    name="_token"
                                                    value="{{ csrf_token('supprimer_' ~ ordre.id) }}"
                                                >

                                                <button
                                                    type="submit"
                                                    class="rounded border border-red-200 px-1.5 py-1 text-[10px] font-semibold text-red-700 hover:bg-red-50"
                                                >
                                                    Supprimer
                                                </button>

                                            </form>

                                        {% endif %}

                                    </div>

                                </td>

                            </tr>

                        {% endif %}

                    {% endfor %}

                    {% if aucuneAttente %}

                        <tr class="ligne-vide-attente">

                            <td
                                colspan="5"
                                class="px-3 py-4 text-center text-[10px] italic text-slate-400"
                            >
                                Aucun OF en attente.
                            </td>

                        </tr>

                    {% endif %}

                </tbody>

            </table>

        </div>

    </section>


    {# ============================================================ #}
    {# KANBAN : EN COURS #}
    {# ============================================================ #}

    <section class="mb-3 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">

        <div class="flex items-center justify-between border-b border-slate-200 bg-blue-50 px-3 py-2">

            <div class="flex items-center gap-2">

                <span class="h-2.5 w-2.5 rounded-full bg-blue-500"></span>

                <h2 class="text-sm font-bold text-blue-800">
