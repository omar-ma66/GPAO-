<!DOCTYPE html>

<html lang="fr">

<head>


<meta charset="UTF-8">

<meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
>

<title>
    {% block title %}GPAO{% endblock %}
</title>

{% block stylesheets %}
{% endblock %}

{% block javascripts %}
    {{ importmap('app') }}
{% endblock %}


</head>

<body class="min-h-screen bg-slate-100 text-slate-900">

<nav class="border-b border-slate-200 bg-white shadow-sm">


<div class="mx-auto max-w-7xl px-4">

    <div class="flex h-16 items-center justify-between">

        <!-- LOGO -->

        <a
            href="{{ path('app_ordre_fabrication') }}"
            class="flex items-center gap-2 text-xl font-bold text-slate-900"
        >
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-slate-900 text-sm text-white">
                GP
            </span>

            <span>
                GPAO
            </span>
        </a>

        <!-- MENU DESKTOP -->

        <div class="hidden items-center gap-1 md:flex">

            <a
                href="{{ path('app_ordre_fabrication') }}"
                class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
                Ordres de fabrication
            </a>

            <a
                href="{{ path('app_ordre_fabrication_archives') }}"
                class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
                Archives
            </a>

            <a
                href="{{ path('app_produit') }}"
                class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
                Produits
            </a>

            <a
                href="{{ path('app_matiere_premiere') }}"
                class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
                Matières premières
            </a>

            <a
                href="{{ path('app_type_etape') }}"
                class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
                Étapes de fabrication
            </a>

        </div>

        <!-- UTILISATEUR DESKTOP -->

        <div class="hidden items-center gap-3 md:flex">

            {% if app.user %}

                <span class="text-sm text-slate-600">
                    {{ app.user.userIdentifier }}
                </span>

                {% if is_granted('ROLE_ADMIN') %}

                    <span class="rounded-full bg-slate-900 px-3 py-1 text-xs font-semibold text-white">
                        ADMIN
                    </span>

                {% endif %}

                <a
                    href="{{ path('app_logout') }}"
                    class="rounded-lg px-3 py-2 text-sm font-medium text-red-600 hover:bg-red-50"
                >
                    Déconnexion
                </a>

            {% else %}

                <a
                    href="{{ path('app_login') }}"
                    class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700"
                >
                    Connexion
                </a>

            {% endif %}

        </div>

        <!-- BOUTON MOBILE -->

        <button
            id="menu-mobile-button"
            type="button"
            aria-label="Ouvrir le menu"
            aria-expanded="false"
            aria-controls="menu-mobile"
            class="rounded-lg p-2 text-slate-700 hover:bg-slate-100 md:hidden"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"
                />
            </svg>
        </button>

    </div>

    <!-- MENU MOBILE -->

    <div
        id="menu-mobile"
        class="hidden border-t border-slate-200 py-4 md:hidden"
    >

        <div class="flex flex-col gap-1">

            <a
                href="{{ path('app_ordre_fabrication') }}"
                class="rounded-lg px-3 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
                Ordres de fabrication
            </a>

            <a
                href="{{ path('app_ordre_fabrication_archives') }}"
                class="rounded-lg px-3 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
                Archives
            </a>

            <a
                href="{{ path('app_produit') }}"
                class="rounded-lg px-3 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
                Produits
            </a>

            <a
                href="{{ path('app_matiere_premiere') }}"
                class="rounded-lg px-3 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
                Matières premières
            </a>

            <a
                href="{{ path('app_type_etape') }}"
                class="rounded-lg px-3 py-3 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >
                Étapes de fabrication
            </a>

        </div>

        <div class="mt-4 border-t border-slate-200 pt-4">

            {% if app.user %}

                <div class="mb-3 px-3 text-sm text-slate-600">
                    {{ app.user.userIdentifier }}

                    {% if is_granted('ROLE_ADMIN') %}
                        <span class="ml-2 rounded-full bg-slate-900 px-2 py-1 text-xs font-semibold text-white">
                            ADMIN
                        </span>
                    {% endif %}
                </div>

                <a
                    href="{{ path('app_logout') }}"
                    class="block rounded-lg px-3 py-3 text-sm font-medium text-red-600 hover:bg-red-50"
                >
                    Déconnexion
                </a>

            {% else %}

                <a
                    href="{{ path('app_login') }}"
                    class="block rounded-lg bg-slate-900 px-3 py-3 text-center text-sm font-semibold text-white hover:bg-slate-700"
                >
                    Connexion
                </a>

            {% endif %}

        </div>

    </div>

</div>


</nav>

<main>


{% block body %}
{% endblock %}


</main>

<script>
(function () {
    function initMobileMenu() {
        const menuButton = document.getElementById('menu-mobile-button');
        const mobileMenu = document.getElementById('menu-mobile');

        if (!menuButton || !mobileMenu) {
            return;
        }

        if (menuButton.dataset.menuInitialized === 'true') {
            return;
        }

        menuButton.dataset.menuInitialized = 'true';

        menuButton.addEventListener('click', function () {
            mobileMenu.classList.toggle('hidden');

            const isOpen =
                !mobileMenu.classList.contains('hidden');

            menuButton.setAttribute(
                'aria-expanded',
                isOpen ? 'true' : 'false'
            );
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener(
            'DOMContentLoaded',
            initMobileMenu
        );
    } else {
        initMobileMenu();
    }
})();
</script>

</body>

</html>
