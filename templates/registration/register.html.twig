{% extends 'base.html.twig' %}

{% block title %}
    Créer un compte
{% endblock %}

{% block body %}
<style>
._text_shadow{
    text-shadow:5px 5px 5px rgba(0,0,0,.5);
}
</style>
<div class="min-h-[calc(100vh-4rem)] bg-gray-100 py-12">

    <div class="mx-auto max-w-md px-4 sm:px-6">
    {# <div class="mx-auto max-w-md px-4 sm:px-6"> original  #}

        {# En-tête #}
        <div class="mb-8 text-center">

            <div
                class="mx-auto mb-4 flex h-14 w-14 items-center
                       justify-center rounded-full bg-blue-600
                       text-2xl font-bold text-white shadow-md"
            >
                G
            </div>

            <h1 class="text-3xl font-bold tracking-tight text-gray-900 _text_shadow">
                Créer un compte
            </h1>

            <p class="mt-2 text-sm text-gray-600">
                Rejoignez la plateforme GPAO
            </p>

        </div>


        {# Carte du formulaire #}

        <div class="rounded-2xl bg-white p-6 shadow-lg sm:p-8">

            {# Erreurs générales #}

            {% if form_errors(registrationForm) %}

                <div
                    class="mb-6 rounded-lg border border-red-200
                           bg-red-50 p-4 text-sm text-red-700"
                >
                    {{ form_errors(registrationForm) }}
                </div>

            {% endif %}


            {{ form_start(registrationForm) }}

                <div class="space-y-6">

                    {# Email #}

                    <div>

                        {{ form_label(
                            registrationForm.email,
                            'Adresse e-mail',
                            {
                                label_attr: {
                                    class: 'block text-sm font-semibold
                                            text-gray-700'
                                }
                            }
                        ) }}

                        {{ form_widget(
                            registrationForm.email,
                            {
                                attr: {
                                    class: 'mt-2 block w-full rounded-lg
                                            border border-gray-300 bg-white
                                            px-4 py-3 text-gray-900
                                            shadow-sm outline-none
                                            transition
                                            focus:border-blue-500
                                            focus:ring-2
                                            focus:ring-blue-500'
                                }
                            }
                        ) }}

                        {{ form_errors(registrationForm.email) }}

                    </div>


                    {# Mot de passe #}

                    <div>

                        {{ form_label(
                            registrationForm.plainPassword,
                            'Mot de passe',
                            {
                                label_attr: {
                                    class: 'block text-sm font-semibold
                                            text-gray-700'
                                }
                            }
                        ) }}

                        {{ form_widget(
                            registrationForm.plainPassword,
                            {
                                attr: {
                                    class: 'mt-2 block w-full rounded-lg
                                            border border-gray-300 bg-white
                                            px-4 py-3 text-gray-900
                                            shadow-sm outline-none
                                            transition
                                            focus:border-blue-500
                                            focus:ring-2
                                            focus:ring-blue-500'
                                }
                            }
                        ) }}

                        {{ form_errors(registrationForm.plainPassword) }}

                    </div>


                    {# Conditions #}

                    <div
                        class="rounded-lg border border-gray-200
                               bg-gray-50 p-4"
                    >
                        <div class="flex items-start gap-3">

                            {{ form_widget(
                                registrationForm.agreeTerms,
                                {
                                    attr: {
                                        class: 'mt-1 h-4 w-4 rounded
                                                border-gray-300
                                                text-blue-600
                                                focus:ring-blue-500'
                                    }
                                }
                            ) }}

                            <div class="text-sm">

                                {{ form_label(
                                    registrationForm.agreeTerms,
                                    'J’accepte les conditions d’utilisation',
                                    {
                                        label_attr: {
                                            class: 'font-medium
                                                    text-gray-700'
                                        }
                                    }
                                ) }}

                                {{ form_errors(registrationForm.agreeTerms) }}
                               
                            </div>
                           
                        </div>
 
                    </div>
                               

                    {# Bouton #}

                    <button
                        type="submit"
                        class="w-full rounded-lg bg-blue-600
                               px-5 py-3 text-sm font-semibold
                               text-white shadow-sm transition
                               hover:bg-blue-700
                               focus:outline-none
                               focus:ring-2 focus:ring-blue-500
                               focus:ring-offset-2"
                    >
                        Créer mon compte
                    </button>

                </div>

            {{ form_end(registrationForm) }}


            {# Retour connexion #}

            <div class="mt-6 border-t border-gray-200 pt-6 text-center">

                <p class="text-sm text-gray-600">
                    Vous avez déjà un compte ?
                </p>

                <a
                    href="{{ path('app_login') }}"
                    class="mt-2 inline-block text-sm font-semibold
                           text-blue-600 transition
                           hover:text-blue-800"
                >
                    Se connecter
                </a>

            </div>

        </div>

    </div>

</div>

{% endblock %}

